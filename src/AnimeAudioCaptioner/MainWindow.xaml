<Window x:Class="AnimeAudioCaptioner.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="음성 한글자막 0.2.1 — 입력 확인" Height="720" Width="700" MinHeight="620" MinWidth="620"
 WindowStartupLocation="CenterScreen" Background="#10131A" Foreground="#F3F4F6">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel Margin="24">
  <TextBlock Text="음성 한글자막" FontSize="28" FontWeight="Bold"/>
  <TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#B8C2D1" Text="재생 중 대사를 인식해 한 줄씩 표시합니다. 약 1초마다 갱신하며 처리 속도에 따라 지연이 달라집니다."/>
  <Border Padding="16" CornerRadius="10" Background="#182130">
   <StackPanel>
    <TextBlock Text="현재 상태" FontWeight="Bold"/>
    <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Text="준비 중…"/>
    <TextBlock x:Name="RecognitionText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#91D8FF" Text="대사 인식 대기"/>
   </StackPanel>
  </Border>
  <Border Margin="0,12,0,0" Padding="16" CornerRadius="10" Background="#151B26">
   <StackPanel>
    <TextBlock Text="1. 실제 소리 입력" FontWeight="Bold"/>
    <ProgressBar x:Name="AudioMeter" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
    <TextBlock x:Name="AudioText" Margin="0,8,0,0" TextWrapping="Wrap" Text="입력 없음 — 영상을 재생하면 막대가 움직여야 합니다."/>
    <TextBlock Text="2. 인식된 원문" FontWeight="Bold" Margin="0,14,0,0"/>
    <TextBlock x:Name="OriginalText" TextWrapping="Wrap" Margin="0,6,0,0" Text="대사 대기"/>
    <TextBlock Text="3. 한국어 자막" FontWeight="Bold" Margin="0,14,0,0"/>
    <TextBlock x:Name="KoreanText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="18" Foreground="#8FE0B0" Text="번역 대기"/>
    <TextBlock x:Name="TimingText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#B8C2D1" Text="화면 표시까지의 처리 시간을 확인합니다."/>
   </StackPanel>
  </Border>
  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
   <TextBlock Text="듣는 언어" VerticalAlignment="Center"/>
   <ComboBox x:Name="LanguageBox" Margin="12,0,0,0" Width="140" SelectedIndex="0">
    <ComboBoxItem Content="일본어" Tag="ja"/><ComboBoxItem Content="영어" Tag="en"/>
   </ComboBox>
  </StackPanel>
  <TextBlock Margin="0,14,0,0" Foreground="#B8C2D1" TextWrapping="Wrap" Text="모델은 포함되어 있습니다. 스피커·헤드셋의 소리 입력을 자동으로 찾습니다. 음성은 PC에서 인식하고 원문 문장만 온라인 번역으로 전송합니다."/>
  <WrapPanel Margin="0,18,0,0">
   <Button x:Name="StartButton" Width="118" Height="38" Margin="0,0,10,0" Click="StartButton_Click">자막 시작</Button>
   <Button Width="86" Height="38" Margin="0,0,10,0" Click="StopButton_Click">중지</Button>
   <Button x:Name="TestButton" Width="168" Height="38" Click="TestButton_Click">자막 기능 자체 검사</Button>
  </WrapPanel>
 </StackPanel>
 </ScrollViewer>
</Window>
