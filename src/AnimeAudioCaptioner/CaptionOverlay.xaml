<Window x:Class="AnimeAudioCaptioner.CaptionOverlay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
 Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
 <Grid VerticalAlignment="Center" Margin="10">
  <Border x:Name="CaptionBox" Padding="16,10" CornerRadius="10" Background="#DF000000" Opacity="0">
   <TextBlock x:Name="CaptionText" TextWrapping="NoWrap" TextAlignment="Center" Foreground="White"
    FontSize="28" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display"/>
  </Border>
 </Grid>
</Window>
